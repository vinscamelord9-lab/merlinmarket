<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Naija Dimes Hub | Fast. Simple. Reliable.</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body { background: #0b0f17; color: #f3f4f6; font-family: system-ui, -apple-system, sans-serif; }
    .glass { background: rgba(17, 24, 39, 0.9); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.08); }
  </style>
</head>
<body class="min-h-screen flex flex-col">

  <!-- TOP PROMO -->
  <div id="promoBar" class="bg-emerald-600 text-white text-xs py-2 px-4 text-center font-bold flex justify-between items-center">
    <div class="flex-1 text-center">🔥 PROMO ALERT! Get instant game top-ups on Naija Dimes Hub!</div>
    <button onclick="this.parentElement.remove()" class="text-white opacity-80">✕</button>
  </div>

  <!-- NAVBAR -->
  <header class="sticky top-0 z-40 glass border-b border-gray-800">
    <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-2 cursor-pointer" onclick="switchTab('store')">
        <div class="w-9 h-9 rounded-xl bg-emerald-500 font-black text-lg flex items-center justify-center text-black">ND</div>
        <div>
          <h1 class="font-bold text-base text-white leading-none">NAIJA DIMES <span class="text-emerald-400">HUB</span></h1>
          <p class="text-[10px] text-gray-400">Fast. Simple. Reliable.</p>
        </div>
      </div>
      <nav class="flex items-center space-x-2 text-xs font-semibold">
        <button onclick="switchTab('store')" class="px-3 py-2 rounded-lg bg-gray-800 hover:bg-gray-700 text-white"><i class="fa-solid fa-store text-emerald-400 mr-1"></i> Store</button>
        <button onclick="switchTab('track')" class="px-3 py-2 rounded-lg bg-gray-800 hover:bg-gray-700 text-white"><i class="fa-solid fa-magnifying-glass text-emerald-400 mr-1"></i> Track</button>
        <button onclick="openAdminModal()" class="px-3 py-2 rounded-lg bg-emerald-600/20 text-emerald-400 hover:bg-emerald-600 hover:text-white border border-emerald-500/30"><i class="fa-solid fa-user-shield mr-1"></i> Admin</button>
      </nav>
    </div>
  </header>

  <main class="flex-grow max-w-6xl w-full mx-auto px-4 py-6">

    <!-- STORE TAB -->
    <div id="tabStore" class="space-y-6">
      <div class="glass p-6 rounded-2xl border border-gray-800 bg-gradient-to-r from-gray-900 to-emerald-950">
        <span class="text-[10px] font-bold bg-emerald-500/20 text-emerald-400 px-2.5 py-1 rounded-full border border-emerald-500/30">Instant Digital Delivery</span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-white mt-2">Top Up Games Fast in <span class="text-emerald-400">Nigeria</span></h2>
        <p class="text-xs text-gray-400 mt-1">Direct bank transfer supported for PUBG, eFootball, Mobile Legends & more.</p>
        <input type="text" id="searchInput" oninput="renderGames()" placeholder="Search game..." class="mt-4 w-full max-w-md bg-gray-900 border border-gray-700 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-emerald-500">
      </div>

      <div id="gameGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"></div>
    </div>

    <!-- TRACK TAB -->
    <div id="tabTrack" class="hidden max-w-md mx-auto py-6">
      <div class="glass p-6 rounded-2xl text-center space-y-4">
        <h2 class="text-xl font-bold text-white">Track Order Status</h2>
        <input type="text" id="trackIdInput" placeholder="Enter Order ID (e.g. NDH-829102)" class="w-full bg-gray-900 border border-gray-700 rounded-xl px-4 py-3 text-center text-sm font-mono text-white">
        <button onclick="trackOrder()" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-3 rounded-xl text-xs">Search Order</button>
        <div id="trackResult" class="hidden text-left border-t border-gray-800 pt-4 text-xs space-y-2"></div>
      </div>
    </div>

    <!-- ADMIN TAB -->
    <div id="tabAdmin" class="hidden space-y-6">
      <div class="glass p-5 rounded-2xl flex justify-between items-center">
        <div>
          <h2 class="text-xl font-bold text-white"><i class="fa-solid fa-user-shield text-emerald-400 mr-2"></i>Admin Dashboard</h2>
          <p class="text-xs text-gray-400">Logged in as <strong class="text-white">Merlin</strong></p>
        </div>
        <button onclick="logoutAdmin()" class="bg-red-600/20 text-red-400 px-3 py-1.5 rounded-lg text-xs font-bold">Logout</button>
      </div>

      <!-- STATS -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-xs">
        <div class="glass p-3 rounded-xl"><p class="text-gray-400">Total Orders</p><p id="stTotal" class="text-lg font-bold text-white">0</p></div>
        <div class="glass p-3 rounded-xl"><p class="text-amber-400">Pending</p><p id="stPending" class="text-lg font-bold text-amber-300">0</p></div>
        <div class="glass p-3 rounded-xl"><p class="text-emerald-400">Completed</p><p id="stDone" class="text-lg font-bold text-emerald-300">0</p></div>
        <div class="glass p-3 rounded-xl"><p class="text-gray-400">Total Revenue</p><p id="stRev" class="text-lg font-bold text-emerald-400">₦0</p></div>
      </div>

      <!-- ADMIN ORDERS TABLE -->
      <div class="glass p-5 rounded-2xl overflow-x-auto">
        <h3 class="text-sm font-bold text-white mb-3">Order Queue</h3>
        <table class="w-full text-left text-xs text-gray-300">
          <thead class="bg-gray-900 text-gray-400 uppercase">
            <tr><th class="p-2">ID</th><th class="p-2">Customer</th><th class="p-2">Game</th><th class="p-2">UID</th><th class="p-2">Amount</th><th class="p-2">Status</th><th class="p-2">Action</th></tr>
          </thead>
          <tbody id="adminTable" class="divide-y divide-gray-800"></tbody>
        </table>
      </div>
    </div>
  </main>

  <footer class="mt-auto border-t border-gray-800 bg-gray-950 py-6 text-center text-xs text-gray-500">
    <p>© 2026 Naija Dimes Hub. All rights reserved.</p>
  </footer>

  <!-- TOPUP MODAL -->
  <div id="topupModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="glass max-w-md w-full rounded-2xl p-6 relative max-h-[90vh] overflow-y-auto">
      <button onclick="closeModal('topupModal')" class="absolute top-4 right-4 text-gray-400">✕</button>
      <h3 id="mTitle" class="text-lg font-bold text-white mb-1">Top Up Game</h3>
      <p id="mCategory" class="text-xs text-emerald-400 mb-4"></p>

      <div class="space-y-3 mb-4 text-xs">
        <div>
          <label class="block text-gray-300 mb-1">Player UID / ID *</label>
          <input type="text" id="mUid" placeholder="Enter Player ID" class="w-full bg-gray-900 border border-gray-700 rounded-xl px-3 py-2 text-white">
        </div>
        <div id="mZoneBox" class="hidden">
          <label class="block text-gray-300 mb-1">Zone ID *</label>
          <input type="text" id="mZone" placeholder="Zone ID" class="w-full bg-gray-900 border border-gray-700 rounded-xl px-3 py-2 text-white">
        </div>
        <div>
          <label class="block text-gray-300 mb-1">Your Full Name *</label>
          <input type="text" id="mName" placeholder="Full Name" class="w-full bg-gray-900 border border-gray-700 rounded-xl px-3 py-2 text-white">
        </div>
        <div>
          <label class="block text-gray-300 mb-1">Phone Number *</label>
          <input type="tel" id="mPhone" placeholder="08012345678" class="w-full bg-gray-900 border border-gray-700 rounded-xl px-3 py-2 text-white">
        </div>
      </div>

      <label class="block text-xs font-bold text-gray-300 mb-2">Select Package</label>
      <div id="mPkgGrid" class="grid grid-cols-2 gap-2 mb-4 max-h-40 overflow-y-auto"></div>

      <div class="flex justify-between items-center bg-gray-900 p-3 rounded-xl border border-gray-800">
        <div><p class="text-[10px] text-gray-400">Total Price</p><p id="mTotal" class="text-base font-bold text-emerald-400">₦0</p></div>
        <button onclick="proceedToPay()" class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold px-4 py-2 rounded-xl">Pay Now</button>
      </div>
    </div>
  </div>

  <!-- PAYMENT MODAL -->
  <div id="payModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="glass max-w-md w-full rounded-2xl p-6 relative">
      <button onclick="closeModal('payModal')" class="absolute top-4 right-4 text-gray-400">✕</button>
      <h3 class="text-lg font-bold text-white text-center">Bank Transfer Payment</h3>
      <div class="bg-emerald-950/50 border border-emerald-500/30 rounded-xl p-3 my-3 text-center">
        <p class="text-[10px] text-emerald-300">Amount to Transfer</p>
        <p id="pAmount" class="text-2xl font-black text-emerald-400">₦0</p>
        <p class="text-[10px] text-gray-400 mt-0.5">Order ID: <span id="pRef" class="text-white font-mono"></span></p>
      </div>

      <div class="bg-gray-900 p-3 rounded-xl text-xs space-y-1 mb-4 border border-gray-800">
        <p class="flex justify-between"><span class="text-gray-400">Bank Name:</span><span class="font-bold text-white">OPay Digital Bank</span></p>
        <p class="flex justify-between"><span class="text-gray-400">Account No:</span><span class="font-bold text-emerald-400 font-mono">8123456789</span></p>
        <p class="flex justify-between"><span class="text-gray-400">Account Name:</span><span class="font-bold text-white">Naija Dimes Hub</span></p>
      </div>

      <div class="mb-4 text-xs">
        <label class="block text-gray-300 mb-1">Upload Payment Screenshot *</label>
        <input type="file" id="pProof" accept="image/*" class="w-full bg-gray-900 text-xs text-gray-400 file:mr-2 file:py-2 file:px-3 file:rounded-lg file:border-0 file:bg-emerald-600 file:text-white file:font-bold">
      </div>

      <button onclick="confirmOrder()" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-3 rounded-xl text-xs">Confirm Payment</button>
    </div>
  </div>

  <!-- ADMIN LOGIN MODAL -->
  <div id="adminModal" class="fixed inset-0 bg-black/85 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="glass max-w-xs w-full rounded-2xl p-6 relative text-center">
      <button onclick="closeModal('adminModal')" class="absolute top-3 right-3 text-gray-400">✕</button>
      <h3 class="text-lg font-bold text-white mb-4">Admin Login</h3>
      <input type="text" id="aUser" placeholder="Username (Merlin)" class="w-full bg-gray-900 border border-gray-700 rounded-xl px-3 py-2 text-xs text-white mb-2">
      <input type="password" id="aPass" placeholder="Password (merlin1)" class="w-full bg-gray-900 border border-gray-700 rounded-xl px-3 py-2 text-xs text-white mb-3">
      <button onclick="loginAdmin()" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-2.5 rounded-xl text-xs">Login</button>
    </div>
  </div>

  <script>
    const GAMES = [
      { id:'pubg', name:'PUBG MOBILE', cat:'UC Top-Up', icon:'🪖', pkgs:[{n:'60 UC',p:1500},{n:'325 UC',p:7500},{n:'660 UC',p:14500},{n:'1,800 UC',p:36500},{n:'8,100 UC',p:145000}] },
      { id:'efootball', name:'eFootball 2026', cat:'Coins', icon:'⚽', pkgs:[{n:'137 Coins',p:1800},{n:'315 Coins',p:4100},{n:'578 Coins',p:7500},{n:'1,092 Coins',p:13800},{n:'13,440 Coins',p:148000}] },
      { id:'mlbb', name:'Mobile Legends', cat:'Diamonds', icon:'💎', zone:true, pkgs:[{n:'86 Diamonds',p:1000},{n:'257 Diamonds',p:2800},{n:'706 Diamonds',p:7400},{n:'2,120 Diamonds',p:21500}] },
      { id:'fortnite', name:'Fortnite', cat:'V-Bucks', icon:'⚡', pkgs:[{n:'800 V-Bucks',p:10500},{n:'2,400 V-Bucks',p:30000},{n:'12,500 V-Bucks',p:140000}] },
      { id:'eafc', name:'EA SPORTS FC', cat:'FC Points', icon:'🎮', pkgs:[{n:'40 Points',p:550},{n:'520 Points',p:6900},{n:'2,200 Points',p:27500},{n:'12,000 Points',p:138000}] }
    ];

    let orders = JSON.parse(localStorage.getItem('ndh_orders')) || [];
    let selGame = null, selPkg = null, isAdmin = false;

    window.onload = () => renderGames();

    function renderGames() {
      const q = document.getElementById('searchInput').value.toLowerCase();
      const grid = document.getElementById('gameGrid');
      grid.innerHTML = '';
      GAMES.filter(g => g.name.toLowerCase().includes(q)).forEach(g => {
        const div = document.createElement('div');
        div.className = "glass p-4 rounded-2xl flex justify-between items-center";
        div.innerHTML = `
          <div class="flex items-center space-x-3">
            <span class="text-2xl">${g.icon}</span>
            <div><h4 class="font-bold text-white text-sm">${g.name}</h4><p class="text-[10px] text-gray-400">${g.cat}</p></div>
          </div>
          <button onclick="openTopup('${g.id}')" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs px-3 py-2 rounded-xl">Top Up</button>
        `;
        grid.appendChild(div);
      });
    }

    function openTopup(id) {
      selGame = GAMES.find(g => g.id === id);
      document.getElementById('mTitle').innerText = selGame.name;
      document.getElementById('mCategory').innerText = selGame.cat;
      document.getElementById('mZoneBox').className = selGame.zone ? 'block' : 'hidden';

      const grid = document.getElementById('mPkgGrid');
      grid.innerHTML = '';
      selGame.pkgs.forEach((p, idx) => {
        const b = document.createElement('div');
        b.className = `p-2 rounded-xl border text-xs cursor-pointer ${idx===0?'border-emerald-500 bg-emerald-500/10 text-white':'border-gray-800 bg-gray-900 text-gray-400'}`;
        b.onclick = () => {
          selPkg = p;
          document.getElementById('mTotal').innerText = `₦${p.p.toLocaleString()}`;
          Array.from(grid.children).forEach(c=>c.className='p-2 rounded-xl border border-gray-800 bg-gray-900 text-gray-400 text-xs');
          b.className='p-2 rounded-xl border border-emerald-500 bg-emerald-500/10 text-white text-xs';
        };
        b.innerHTML = `<p class="font-bold">${p.n}</p><p class="text-emerald-400">₦${p.p.toLocaleString()}</p>`;
        grid.appendChild(b);
      });

      selPkg = selGame.pkgs[0];
      document.getElementById('mTotal').innerText = `₦${selPkg.p.toLocaleString()}`;
      document.getElementById('topupModal').classList.remove('hidden');
    }

    function proceedToPay() {
      const uid = document.getElementById('mUid').value;
      const name = document.getElementById('mName').value;
      const phone = document.getElementById('mPhone').value;
      if (!uid || !name || !phone) return alert('Fill in all fields!');

      const ref = 'NDH-' + Math.floor(100000 + Math.random() * 900000);
      document.getElementById('pRef').innerText = ref;
      document.getElementById('pAmount').innerText = `₦${selPkg.p.toLocaleString()}`;

      closeModal('topupModal');
      document.getElementById('payModal').classList.remove('hidden');
    }

    function confirmOrder() {
      const ref = document.getElementById('pRef').innerText;
      orders.unshift({
        id: ref,
        game: selGame.name,
        pkg: selPkg.n,
        amount: selPkg.p,
        name: document.getElementById('mName').value,
        phone: document.getElementById('mPhone').value,
        uid: document.getElementById('mUid').value,
        status: 'Payment Submitted',
        date: new Date().toLocaleDateString()
      });
      localStorage.setItem('ndh_orders', JSON.stringify(orders));
      closeModal('payModal');
      alert(`Order ${ref} Submitted Successfully!`);
      switchTab('track');
      document.getElementById('trackIdInput').value = ref;
      trackOrder();
    }

    function trackOrder() {
      const q = document.getElementById('trackIdInput').value.trim().toUpperCase();
      const res = document.getElementById('trackResult');
      res.classList.remove('hidden');
      const o = orders.find(x => x.id === q);
      if (!o) {
        res.innerHTML = '<p class="text-red-400 font-bold text-center">Order Not Found</p>';
        return;
      }
      res.innerHTML = `
        <p class="flex justify-between"><span class="text-gray-400">Status:</span><span class="font-bold text-emerald-400">${o.status}</span></p>
        <p class="flex justify-between"><span class="text-gray-400">Game:</span><span class="text-white">${o.game} (${o.pkg})</span></p>
        <p class="flex justify-between"><span class="text-gray-400">Price:</span><span class="text-white">₦${o.amount.toLocaleString()}</span></p>
      `;
    }

    function openAdminModal() {
      if (isAdmin) switchTab('admin');
      else document.getElementById('adminModal').classList.remove('hidden');
    }

    function loginAdmin() {
      const u = document.getElementById('aUser').value;
      const p = document.getElementById('aPass').value;
      if (u === 'Merlin' && p === 'merlin1') {
        isAdmin = true;
        closeModal('adminModal');
        switchTab('admin');
        renderAdmin();
      } else alert('Invalid Credentials');
    }

    function logoutAdmin() {
      isAdmin = false;
      switchTab('store');
    }

    function renderAdmin() {
      document.getElementById('stTotal').innerText = orders.length;
      document.getElementById('stPending').innerText = orders.filter(o=>o.status==='Payment Submitted').length;
      document.getElementById('stDone').innerText = orders.filter(o=>o.status==='Completed').length;
      document.getElementById('stRev').innerText = '₦' + orders.filter(o=>o.status==='Completed').reduce((s,o)=>s+o.amount,0).toLocaleString();

      const tbody = document.getElementById('adminTable');
      tbody.innerHTML = '';
      orders.forEach(o => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td class="p-2 font-mono text-emerald-400">${o.id}</td>
          <td class="p-2 font-bold text-white">${o.name}</td>
          <td class="p-2">${o.game}</td>
          <td class="p-2 font-mono">${o.uid}</td>
          <td class="p-2 font-bold text-emerald-400">₦${o.amount.toLocaleString()}</td>
          <td class="p-2">
            <select onchange="changeStatus('${o.id}', this.value)" class="bg-gray-900 border border-gray-700 text-white rounded p-1">
              <option value="Payment Submitted" ${o.status==='Payment Submitted'?'selected':''}>Pending</option>
              <option value="Completed" ${o.status==='Completed'?'selected':''}>Completed</option>
              <option value="Cancelled" ${o.status==='Cancelled'?'selected':''}>Cancelled</option>
            </select>
          </td>
          <td class="p-2"><button onclick="deleteOrd('${o.id}')" class="text-red-400">✕</button></td>
        `;
        tbody.appendChild(tr);
      });
    }

    function changeStatus(id, st) {
      const o = orders.find(x => x.id === id);
      if (o) { o.status = st; localStorage.setItem('ndh_orders', JSON.stringify(orders)); renderAdmin(); }
    }

    function deleteOrd(id) {
      orders = orders.filter(x => x.id !== id);
      localStorage.setItem('ndh_orders', JSON.stringify(orders));
      renderAdmin();
    }

    function switchTab(tab) {
      document.getElementById('tabStore').className = tab==='store'?'space-y-6':'hidden';
      document.getElementById('tabTrack').className = tab==='track'?'max-w-md mx-auto py-6':'hidden';
      document.getElementById('tabAdmin').className = tab==='admin'?'space-y-6':'hidden';
    }

    function closeModal(id) { document.getElementById(id).classList.add('hidden'); }
  </script>
</body>
</html>
